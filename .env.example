# Set automatically when you add the Upstash Redis integration on Vercel.
# Without these, the app uses in-memory storage (fine for local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email is required in production (sign-in codes + expense notifications). Set ONE of:

# Option 1: Brevo (https://www.brevo.com), free for 300 emails a day with no domain needed.
# EMAIL_FROM_ADDRESS must be a sender you've verified in Brevo (e.g. your Gmail address).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=you@gmail.com

# Option 2: Gmail (no domain needed). Needs 2-Step Verification and an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Option 3: Resend (https://resend.com), which needs a domain you've verified there.
RESEND_API_KEY=
EMAIL_FROM="SplitApp <splits@yourdomain.com>"

# Optional: public URL used for links in emails (defaults to the URL the request came in on).
APP_URL=
