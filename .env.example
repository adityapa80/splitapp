# Set automatically when you add the Upstash Redis integration on Vercel.
# Without these, the app uses in-memory storage (fine for local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend (https://resend.com): sends sign-in codes and expense notifications. Required in production.
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend. Without a verified domain,
# Resend's test sender (onboarding@resend.dev) can only deliver to your own Resend account email.
EMAIL_FROM="SplitApp <splits@yourdomain.com>"
# Optional: public URL used for links in emails (defaults to the URL the request came in on).
APP_URL=
